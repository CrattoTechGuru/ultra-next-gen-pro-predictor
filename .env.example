FOOTBALL_DATA_API_KEY=
DATABASE_URL=
DATABASE_SSL=true
ADMIN_KEY=
NODE_ENV=production
# Provider sync controls
SYNC_INTERVAL_MINUTES=30
HISTORY_DAYS=90
UPCOMING_DAYS=30
# Keep provider date windows under 10 days; 6500ms is conservative for low-rate plans.
FOOTBALL_DATA_MIN_REQUEST_MS=6500

LIVE_POLL_SECONDS=90

# Optional secondary football provider (API-Sports) for competitions not available from football-data.org
API_SPORTS_KEY=
# Comma-separated API-Sports league IDs to import, e.g. 288,197
API_SPORTS_LEAGUE_IDS=
# Season year used by API-Sports, e.g. 2026
API_SPORTS_SEASON=
